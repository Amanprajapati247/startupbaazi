# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database (SQLite for zero-config local development, or PostgreSQL URL)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for Supabase / Neon / Render:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/startupbaazi?schema=public"

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_EXPIRES_IN=7d

# Razorpay Test / Production Keys
# Get these from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Stripe Integration (Global standard & reliable for cards + INR)
# Get these from Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Direct UPI Payment Option
UPI_VPA=startupbaazi@upi
UPI_MERCHANT_NAME=StartupBaazi Technologies

# Leaderboard Bidding Defaults (in INR ₹)
DEFAULT_MIN_BID_AMOUNT=500
DEFAULT_MIN_BID_INCREMENT=100
