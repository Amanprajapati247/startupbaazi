# =================================================================
# StartupBaazi Deployment Environment Variables Reference
# =================================================================

# Server & Runtime
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-domain.com

# Database (PostgreSQL URL for Production: Supabase, Neon, Render, or Railway)
DATABASE_URL="postgresql://username:password@db-host:5432/startupbaazi?sslmode=require"

# JWT Authentication (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_random_key_here_32_chars
JWT_EXPIRES_IN=7d

# Razorpay Payment Gateway (Test or Live)
# Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe Payment Gateway (Global cards + Indian cards)
# Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Direct UPI QR & VPA Payment
UPI_VPA=startupbaazi@upi
UPI_MERCHANT_NAME=StartupBaazi Technologies

# Client Frontend (when deploying client separately on Vercel/Netlify)
# VITE_API_URL=https://your-api-domain.onrender.com
