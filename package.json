{
  "name": "startupbaazi-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "StartupBaazi - India's Paid Startup Visibility & Leaderboard Platform",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "start": "npm --prefix server start",
    "db:prepare": "npm --prefix server run db:prepare",
    "test:server": "npm --prefix server test",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:seed": "npm --prefix server run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
